    {
      "cell_type": "code",
      "source": [
        "# Defining and Fitting the model with the optimal k\n",
        "\n",
        "# Define the final KNN model with the optimal k\n",
        "knn_model = KNeighborsClassifier(n_neighbors=optimal_k)\n",
        "\n",
        "# Fit the model on the entire scaled training data\n",
        "knn_model.fit(X_train_scaled, y_train)\n",
        "\n",
        "print(\"Final KNN model defined and fitted with optimal k.\")\n",
        "\n",
        "# Plot the accuracy vs k to visualize the tuning process\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(k_values, accuracy_scores, marker='o', linestyle='--')\n",
        "plt.title('Accuracy vs. Number of Neighbors (k)')\n",
        "plt.xlabel('Number of Neighbors (k)')\n",
        "plt.ylabel('Accuracy')\n",
        "plt.xticks(k_values)\n",
        "plt.grid(True)\n",
        "plt.axvline(x=optimal_k, color='r', linestyle='-', label=f'Optimal k={optimal_k}')\n",
        "plt.legend()\n",
        "plt.savefig(\"k_tuning_accuracy.png\")"
