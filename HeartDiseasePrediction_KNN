    {
      "cell_type": "markdown",
      "source": [
        "**Identifying the appropriate number of neighbours**"
      ],
      "metadata": {
        "id": "XxOtQ_TUlCXo"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Identifying the appropriate number of neighbours for the KNN algorithm\n",
        "\n",
        "# List to store accuracy for different values of k\n",
        "accuracy_scores = []\n",
        "k_values = range(1, 21) # Checking k from 1 to 20\n",
        "\n",
        "# Loop through k values to find the best one\n",
        "for k in k_values:\n",
        "    # Define and Fit the model (This is temporary for tuning k)\n",
        "    knn_temp = KNeighborsClassifier(n_neighbors=k)\n",
        "    knn_temp.fit(X_train_scaled, y_train)\n",
        "\n",
        "    # Predict on the test set\n",
        "    y_pred_temp = knn_temp.predict(X_test_scaled)\n",
        "\n",
        "    # Evaluate accuracy and store it\n",
        "    accuracy = accuracy_score(y_test, y_pred_temp)\n",
        "    accuracy_scores.append(accuracy)\n",
        "\n",
        "# Find the optimal k that maximizes the accuracy\n",
        "optimal_k_index = np.argmax(accuracy_scores)\n",
        "optimal_k = k_values[optimal_k_index]\n",
        "max_accuracy = accuracy_scores[optimal_k_index]\n",
        "\n",
        "print(f\"Optimal number of neighbors (k) found: {optimal_k}\")\n",
        "print(f\"Maximum accuracy for optimal k on the test set: {max_accuracy:.4f}\")"
      ],
      "metadata": {
